### minimal installation
{{- if .minimal }}
{{- $files := concat .minimal_files .minimal_scripts -}}
{{- if .secrets -}}
{{-   $files = concat $files .minimal_secrets -}}
{{- end }}
**
{{- range $pf := $files }}
  {{- $path := $pf -}}
  {{- if regexMatch "/\\*\\*$" $pf }}
    {{- $path = regexReplaceAll "/\\*\\*$" $pf "/" -}}
  {{- else if regexMatch "/\\*$" $pf }}
    {{- $path = regexReplaceAll "/\\*$" $pf "/" -}}
  {{- end }}
  {{- $parts := splitList "/" $path -}}
  {{- $prefix := "" -}}
  {{- range $i, $part := $parts }}
    {{- if eq $part "" }}{{- continue -}}{{- end }}
    {{- $prefix = print $prefix $part "/" -}}
    {{- if lt $i (sub (len $parts) 1) }}
!{{$prefix}}
    {{- end }}
  {{- end }}
!{{$pf}}
{{- end }}
{{- end }}

# Secret availability is independent of the installation scope.
{{- if not .secrets }}
{{- range $source := glob (joinPath .chezmoi.sourceDir "**/*.age") }}
{{- $path := trimPrefix (print $.chezmoi.sourceDir "/") $source -}}
{{- $path = regexReplaceAll "(^|/)(encrypted_|private_|executable_)+" $path "${1}" -}}
{{- $path = regexReplaceAll "(^|/)dot_" $path "${1}." -}}
{{- $path = trimSuffix ".tmpl" (trimSuffix ".age" $path) }}
{{$path}}
{{- end }}
{{- end }}

