{{- $secrets := false  -}}
{{- if or (stat (joinPath .chezmoi.homeDir ".config/chezmoi/chezmoi.age")) (stat (joinPath .chezmoi.homeDir "chezmoi.age")) -}}
{{-   $secrets = true  -}}
{{- end -}}

{{- $email := (get . "email") | default "chu@vchu.net " -}}
{{- $name  := (get . "name")  | default "Victor Chu" -}}
{{- $minimal := true -}}
{{- if hasKey . "minimal" -}}
{{-   $minimal = .minimal -}}
{{- end -}}
{{- $syncSudoers := false -}}
{{- if hasKey . "sync_sudoers" -}}
{{-   $syncSudoers = .sync_sudoers -}}
{{- end -}}

{{-   if stdinIsATTY -}}
{{-     $minimal = promptBool "minimal install" $minimal -}}
{{-     $email = promptString "email" $email -}}
{{-     $name = promptString "name" $name -}}
{{-     $syncSudoers = promptBool "sync sudoers configuration" $syncSudoers -}}
{{-   end -}}

umask = {{ if eq .chezmoi.os "darwin" }}0o22{{ else }}0o02{{ end }}

{{if $secrets -}}
encryption = "age"
[age]
  identity = "~/.config/chezmoi/chezmoi.age"
  recipient = "age1myfxv62zvx85n04v755glrxyz5gckjxn0w9shd5m70s03wtcd43qf0mqcl"
{{- end }}


[edit]
  watch = true

[[textconv]]
pattern = "**/*.plist"
command = "plutil"
args = ["-convert", "xml1", "-o", "-", "-"]

[git]
  autoadd = true
  autoCommit = false
  autopush = false

[data]
  minimal = {{ $minimal }}
  secrets = {{ $secrets }}
  email = "{{ $email }}"
  name = "{{ $name }}"
  sync_sudoers = {{ $syncSudoers }}
