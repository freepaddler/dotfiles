#!/bin/sh

# Report available updates and configuration differences on macOS.
[ "$(uname -s)" = Darwin ] || { echo "updates-check-macos: macOS is required" >&2; exit 1; }

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
section() { [ -z "$2" ] || printf '%s\n%s\n\n' "$1" "$2"; }

# In Shortcuts there is no terminal for a password prompt; fail visibly instead.
if [ -t 0 ]; then
    result=$(sudo /usr/sbin/softwareupdate --list 2>&1)
    update_status=$?
else
    result=$(sudo -n /usr/sbin/softwareupdate --list 2>&1)
    update_status=$?
fi
if [ "$update_status" -ne 0 ] || printf '%s\n' "$result" | LC_ALL=C grep -qi 'error'; then
    result=$(printf '%s\n' "$result" | sed '/^[[:space:]]*Software Update Tool[[:space:]]*$/d')
    section 'ERROR: macOS software update check failed:' "${result:-softwareupdate exited with status $update_status}"
else
    # Keep update entries and their details; omit scan progress and headings.
    result=$(printf '%s\n' "$result" | sed -n '/^[[:space:]]*\* Label:/,$p')
    section 'macOS / Apple updates:' "$result"
fi
unset update_status

if result=$(brew update 2>&1); then
    if result=$(brew outdated --verbose 2>&1); then
        section 'Available updates:' "$result"
    else
        section 'ERROR: brew outdated failed:' "$result"
    fi
else
    section 'ERROR: brew update failed:' "$result"
fi
if result=$(pkg-sync diff 2>&1); then
    section 'Package differences (+ installed outside lists; - missing):' "$result"
else
    section 'ERROR: pkg-sync diff failed:' "$result"
fi
if result=$(chezmoi status --exclude=scripts 2>&1); then
    section 'Chezmoi file differences:' "$result"
else
    section 'ERROR: chezmoi status failed:' "$result"
fi
if result=$(chezmoi git -- status --porcelain=v1 2>&1); then
    section 'Chezmoi uncommitted changes:' "$result"
else
    section 'ERROR: chezmoi git status failed:' "$result"
fi
if result=$(chezmoi git -- log --branches --not --remotes --oneline 2>&1); then
    section 'Chezmoi unpushed commits (local remote refs):' "$result"
else
    section 'ERROR: chezmoi git log failed:' "$result"
fi
exit 0
